{
  "name": "qazrem",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "migrate:up": "dotenv -e .env -- npx node-pg-migrate up -m backend/migrations",
    "migrate:down": "dotenv -e .env -- npx node-pg-migrate down -m backend/migrations",
    "migrate:create": "cd backend && npx node-pg-migrate create"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv-cli": "^11.0.0"
  }
}